{
  "title": "Travel Booking Reliability",
  "uid": "travel-reliability",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests / sec",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(travel_http_requests_total[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Average response time (seconds)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(travel_http_request_duration_seconds_sum[1m])) / sum(rate(travel_http_request_duration_seconds_count[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Booking actions",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (action) (travel_bookings_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Application up",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "travel_demo_up",
          "refId": "A"
        }
      ]
    }
  ]
}